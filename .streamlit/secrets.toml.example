# -------------------------------------------------------------------------
# Streamlit secrets template
# -------------------------------------------------------------------------
# To use locally:
#   1. Copy this file to .streamlit/secrets.toml
#   2. Fill in your real keys below
#   3. NEVER COMMIT secrets.toml — it is already in .gitignore
#
# To use on Streamlit Community Cloud:
#   Paste these values into the app's "Secrets" panel in the dashboard.
#   Go to: your app → ⋮ menu → Settings → Secrets
# -------------------------------------------------------------------------

# WoS Starter API key
# -------------------
# Used for: WoS UT lookup + PubMed ID lookup
# How to get: https://developer.clarivate.com/ → register app → subscribe to
#             "Web of Science Starter API" → copy key
# Plans: Free (50 req/day for testing), Subscriber (5,000 req/day for production)
WOS_API_KEY = "paste-your-clarivate-starter-key-here"

# WoS Expanded API key (optional)
# --------------------------------
# Used for: full metadata enrichment — abstract, keywords, pages, WoS categories,
#           research areas, editions (SCI/SSCI/ESCI), KeyWords Plus, funding
# How to get: contact your Clarivate account manager — this is an institutional
#             subscription separate from the Starter API
# Quota: tracked per year via X-REC-AmtPerYear-Remaining response header
# Leave as empty string "" if you only have the Starter key
WOS_EXPANDED_API_KEY = "paste-your-clarivate-expanded-key-here"
